{
  "name": "video-to-audio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-friendly web app that extracts audio from videos as M4A, MP3 or WAV, entirely on the device.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "deploy": "npm run build && wrangler deploy",
    "build:core": "core/build.sh",
    "fixtures": "tests/fixtures/generate.sh"
  },
  "dependencies": {
    "preact": "^11.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
